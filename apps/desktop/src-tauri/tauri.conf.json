{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDFTool",
  "version": "0.1.0",
  "identifier": "com.example.pdftool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PDF Tool",
        "width": 1280,
        "height": 850,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "./resources/bin/*"
    ]
  }
}
